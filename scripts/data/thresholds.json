{
  "version": 1,
  "_about": "novel_lint.py の警報線の唯一の権威。references や SKILL.md に同じ数値を書かない（ID と名称で参照する）。密度の単位は narr=地の文1000字あたり、total=全文1000字あたり。calibrated: aozora33=青空文庫33作品の計量と照合済み / partial=照合したが現代文では未較正 / none=未較正の初期値。作品ごとの上書きは style/lint.json の overrides に理由つきで書く。",
  "guards": {
    "density_min_chars": 600,
    "density_min_count": 3,
    "run_share_min_sentences": 20,
    "cv_min_sentences": 12,
    "cv_full_sentences": 30,
    "para_cv_min_paras": 8,
    "dialogue_rate_min_utterances": 10,
    "body_min_chars": 100
  },
  "dialogue_ratio_target": {
    "bungei": 0.3,
    "entertainment": 0.45,
    "web": 0.45,
    "tolerance": 0.15
  },
  "rules": {
    "R01": {
      "name": "同一文末の連続",
      "kind": "run",
      "calibrated": "aozora33",
      "hint": "文末だけ差し替えない。刻んだ動作を一文に束ねる、目の前の状態をル形に落とす、台詞で切る",
      "profiles": {
        "default": {
          "info": 4,
          "warn": 6,
          "strong": 8
        },
        "keitai": {
          "info": 5,
          "warn": 8,
          "strong": 12
        }
      }
    },
    "R02": {
      "name": "4連以上の同一文末に属する文の割合",
      "kind": "upper",
      "calibrated": "aozora33",
      "hint": "単調が意図（喪・解離・報告体）でなければ、出来事と状態を書き分ける",
      "profiles": {
        "default": {
          "warn": 0.35,
          "strong": 0.5
        }
      }
    },
    "R03": {
      "name": "た止め率（文末の表層パターンによる近似。発話タグ文を除く）",
      "kind": "upper",
      "calibrated": "aozora33",
      "hint": "状態・知覚までタ形で報告していないか見る",
      "profiles": {
        "default": {
          "warn": 0.8
        }
      }
    },
    "L01": {
      "name": "文長の変動係数（地の文）",
      "kind": "lower",
      "calibrated": "aozora33",
      "hint": "同じ長さの文が並んでいる。平時は因果と観察を一文で繋ぎ、止めたい所だけ短く切る",
      "profiles": {
        "default": {
          "info": 0.5,
          "warn": 0.4
        }
      }
    },
    "L02": {
      "name": "平均文長の下限（地の文）",
      "kind": "lower",
      "calibrated": "partial",
      "hint": "短文の刻みすぎ。無人の観察は繋ぐ（短文基調を宣言した作品は keep）",
      "profiles": {
        "default": {
          "info": 22
        },
        "web": {
          "info": 15
        }
      }
    },
    "L03": {
      "name": "長い文",
      "kind": "list_over",
      "calibrated": "partial",
      "hint": "一本の運動が通っているか。節を並べただけなら割る",
